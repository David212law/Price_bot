name: Dashboard Cron
on:
  schedule:
    - cron: '0 */6 * * *'
  workflow_dispatch:
permissions:
  contents: write
concurrency:
  group: state-commits
  cancel-in-progress: false
jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - run: pip install requests
      - name: Update tracker
        run: python -m research_lab.kucoin_combo_tracker
      - name: Generate dashboard
        run: python -m research_lab.dashboard_full
      - name: Commit
        run: |
          git config user.name 'github-actions[bot]'
          git config user.email 'github-actions[bot]@users.noreply.github.com'
          git add -f exchanges/kucoin/state/m11_kucoin_shadow_combo_state.json || true
          git add -f reports/dashboard.html || true
          if ! git diff --staged --quiet; then
            git commit -m "Auto: dashboard update [skip ci]"
            git push
          fi
