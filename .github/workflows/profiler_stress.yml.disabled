name: Profiler Full Stress

on:
  workflow_dispatch: # فقط دستی اجرا می‌شود تا سهمیه الکی مصرف نشود

permissions:
  contents: write

jobs:
  profile:
    runs-on: ubuntu-latest
    timeout-minutes: 360 # حداکثر ۶ ساعت مجاز است

    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - run: pip install requests

      - name: Reset Unstressed
        run: python research_lab/reset_unstressed.py

      - name: Run Profiler
        run: python -m research_lab.profiler

      - name: Commit State
        run: |
          git config user.name 'github-actions[bot]'
          git config user.email 'github-actions[bot]@users.noreply.github.com'
          git add -f research_lab/logs/profiles/ || true
          if ! git diff --staged --quiet; then
            git commit -m "Auto: full profiler stress complete [skip ci]"
            git push
          else
            echo "No changes to commit"
          fi
