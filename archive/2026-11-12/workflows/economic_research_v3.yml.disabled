name: Economic Research V3 (OI + L/S + On-chain)

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  run:
    runs-on: ubuntu-latest
    timeout-minutes: 90
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - run: pip install requests
      - name: Run economic_researcher_v3
        run: PYTHONPATH=. python3 -m research_lab.economic_researcher_v3
        continue-on-error: true
      - name: Commit
        if: always()
        run: |
          git config user.name 'github-actions[bot]'
          git config user.email 'github-actions[bot]@users.noreply.github.com'
          git add -A
          if ! git diff --staged --quiet; then
            git commit -m "Auto: economic v3 $(date -u +%Y-%m-%d-%H) [skip ci]"
            git pull --rebase origin main || true
            git push || echo "push failed"
          fi
