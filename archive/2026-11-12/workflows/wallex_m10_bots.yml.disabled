name: Wallex M10 Bots

on:
  schedule:
    - cron: '0 1 * * *' # اجرا روزانه ساعت 01:00 UTC (یک ساعت بعد از Midnight)
  workflow_dispatch:

concurrency:
  group: ${{ github.workflow }}
  cancel-in-progress: false # اجرای قبلی را قطع نکن، اجازه بده تمام شود

permissions:
  contents: write

jobs:
  run-wallex-bots:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.10'
      - name: Install dependencies
        run: pip install requests
      - name: Run Bots
        env:
          BALE_BOT_TOKEN: ${{ secrets.BALE_BOT_TOKEN }}
          BALE_CHAT_ID: ${{ secrets.BALE_CHAT_ID }}
          GH_TOKEN: ${{ secrets.GH_TOKEN }}
          GH_REPO: ${{ github.repository }}
        run: python exchanges/wallex/run_wallex_m10.py
